# Starship prompt — generated by devuan-cinnamon-setup from
# config/palette/catppuccin-mocha.toml. Layout descends from ohmydebn's
# starship.toml (https://github.com/dougburks/ohmydebn, MIT licensed) but
# bakes the palette hex values in directly (no dynamic-terminal-color mode)
# so the prompt matches the theme on any terminal.
"$schema" = 'https://starship.rs/config-schema.json'

add_newline = false

format = """
$os\
$username\
[](fg:{{ cyan }} bg:{{ accent }})\
$directory\
[](fg:{{ green }} bg:{{ cyan }})\
$git_branch\
$git_status\
[ ](fg:{{ green }})\
$line_break$character"""

[os]
disabled = false
style = "bg:{{ accent }} fg:black"

[os.symbols]
Windows = "󰍲"
Ubuntu = "󰕈"
SUSE = ""
Raspbian = "󰐿"
Mint = "󰣭"
Manjaro = ""
Linux = "󰌽"
Gentoo = "󰣨"
Fedora = "󰣛"
Alpine = ""
Arch = "󰣇"
Artix = "󰣇"
CentOS = ""
Debian = "󰣚"
Redhat = "󱄛"
RedHatEnterprise = "󱄛"

[username]
show_always = false
style_user = "bg:{{ accent }} fg:black"
style_root = "bg:{{ accent }} fg:black"
format = '[ $user ]($style)'

[directory]
style = "fg:black bg:{{ cyan }}"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = "󰝚 "
"Pictures" = " "
"Developer" = "󰲋 "

[git_branch]
symbol = ""
style = "bg:{{ green }}"
format = '[[ $symbol $branch ](fg:black bg:{{ green }})]($style)'

[git_status]
style = "bg:{{ green }}"
format = '[[($all_status$ahead_behind )](fg:black bg:{{ green }})]($style)'

[line_break]
disabled = true

[character]
disabled = false
success_symbol = '[](bold fg:{{ green }})'
error_symbol = '[](bold fg:{{ red }})'
vimcmd_symbol = '[](bold fg:{{ cyan }})'
vimcmd_replace_one_symbol = '[](bold fg:{{ red }})'
vimcmd_replace_symbol = '[](bold fg:{{ red }})'
vimcmd_visual_symbol = '[](bold fg:{{ accent }})'

[status]
disabled = false
format = '[ $status ](fg:black bg:{{ red }})'

[cmd_duration]
min_time = 2000
format = 'took [$duration](fg:{{ yellow }}) '

[python]
symbol = " "
style = "bg:{{ magenta }}"
format = '[[ $symbol$version ](fg:black bg:{{ magenta }})]($style)'

[nodejs]
symbol = " "
style = "bg:{{ green }}"
format = '[[ $symbol$version ](fg:black bg:{{ green }})]($style)'

[rust]
symbol = "󱘗 "
style = "bg:{{ accent }}"
format = '[[ $symbol$version ](fg:black bg:{{ accent }})]($style)'

[container]
symbol = "⬢ "
format = '[$symbol $name](bold fg:{{ cyan }}) '