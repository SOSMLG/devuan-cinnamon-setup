#!/usr/bin/env bash
# devuan-first-run — welcome + first update + Timeshift check, once per user.
# Deployed by scripts/09-updateSystem.sh as ~/.local/bin/devuan-first-run with
# an autostart entry. Idempotent via a done-file; never touches user choices.
# Adapted from Butterbian/XfceMlg's first-run-setup for Devuan + OpenRC
# (no systemd timers; cron/update-gui is the update path here).

DONE_FILE="$HOME/.config/devuan-cinnamon/first-run-complete"

[[ -f "$DONE_FILE" ]] && exit 0

# Only make sense inside a graphical Cinnamon session.
[[ -z "${DISPLAY:-}" ]] && exit 0

mkdir -p "$HOME/.config/devuan-cinnamon" "$HOME/Screenshots"

BOLD="\e[1m"
GREEN="\e[32m"
CYAN="\e[36m"
YELLOW="\e[33m"
RESET="\e[0m"

clear
echo ""
echo -e "${BOLD}${CYAN}  ========================================${RESET}"
echo -e "${BOLD}${CYAN}    Welcome — Devuan Cinnamon Set-up${RESET}"
echo -e "${BOLD}${CYAN}  ========================================${RESET}"
echo ""
echo -e "  A couple of things to get you started.\n"

# ── Task 1: system update ─────────────────────────────────────────────
echo -e "${BOLD}  [ 1/2 ] System update${RESET}"
echo -e "  Running an update pulls the latest fixes since this setup ran.\n"
echo -ne "  Run system update now? [Y/n] "
read -r answer
if [[ ! "$answer" =~ ^[Nn]$ ]]; then
    # Skewed clocks make apt reject InRelease signatures (NTP fixes that);
    # wait briefly for a synced clock if the user runs chrony/ntp.
    if command -v chronyc &>/dev/null; then
        for _ in $(seq 1 15); do
            chronyc tracking 2>/dev/null | grep -q "Leap status.*Normal" && break
            sleep 1
        done
    elif command -v ntpq &>/dev/null; then
        for _ in $(seq 1 15); do
            ntpq -p 2>/dev/null | grep -q '^\*' && break
            sleep 1
        done
    fi
    echo -e "\n${YELLOW}  Running: sudo apt-get update && sudo apt-get full-upgrade${RESET}\n"
    sudo apt-get update && sudo apt-get full-upgrade -y
    echo -e "\n${GREEN}  System update complete.${RESET}\n"
else
    echo -e "  ${YELLOW}Skipped. Update when ready from the update notifier (Super+M > Update).${RESET}\n"
fi

echo ""

# ── Task 2: Timeshift ─────────────────────────────────────────────────
echo -e "${BOLD}  [ 2/2 ] Timeshift snapshots${RESET}"
echo -e "  Timeshift is installed by this tool kit. Opening it once lets you"
echo -e "  verify the schedule and take your first manual snapshot.\n"
echo -ne "  Open Timeshift now? [Y/n] "
read -r answer
if [[ ! "$answer" =~ ^[Nn]$ ]]; then
    echo -e "\n${YELLOW}  Launching Timeshift (needs privilege)...${RESET}"
    sudo timeshift-gtk 2>/dev/null || sudo timeshift-launcher 2>/dev/null || true
else
    echo -e "  ${YELLOW}Skipped. Launch Timeshift from the menu when ready.${RESET}\n"
fi

echo ""
echo -e "${GREEN}${BOLD}  Setup complete. Enjoy your desktop!${RESET}"
echo ""
echo -e "  ${CYAN}Tips:${RESET}"
echo -e "  • Super+M — Devuan Menu (apps, AI, update, system)"
echo -e "  • Super+Return — terminal    • Super+A — OpenCode"
echo -e "  • Weekly SSD trim + update checks run via cron (09:00 / 18:00)"
echo ""

# Done-file only after the tasks finished: Ctrl+C mid-run must NOT leave
# the wizard permanently suppressed (a stale done-file would re-run nothing).
touch "$DONE_FILE"

read -rp "  Press Enter to close... " _